{
  "name": "@orangefive/dsh-particle-scene",
  "version": "1.0.0",
  "description": "Sci-fi particle text scene + glassmorphism buttons for the DeepSeek Harness (DSH) web UI — hover scatters the particles apart, one click reverts to the stock UI.",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc <2",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.1-rc <2",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.1.1-rc <2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "unrun": "^0.3.1"
  }
}
